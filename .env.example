# 复制这个文件为 .env，然后填上你自己的 Key。.env 不要提交到 Git。
# 任何 "OpenAI 兼容" 的接口都可以用，下面默认是 DeepSeek。

LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 更强也更贵的模型：deepseek-v4-pro

# 可选：DeepSeek 思考模式。on = 开，off = 关；不写就用 DeepSeek 默认（默认是开）。
# 关掉后回复更快、更省钱；做复杂任务时可以打开。
# LLM_THINKING=off

# 可选：一次提问最多执行多少步
# AGENT_MAX_STEPS=30
